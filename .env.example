# Local Supabase PostgreSQL connection used by server-side application code.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:15432/postgres

# Local Supabase Storage API used only by server-side route handlers.
SUPABASE_URL=http://127.0.0.1:15431
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-secret-key-from-pnpm-db-status

# One-time production bootstrap values. Set them only while running
# `pnpm identity:bootstrap-admin`, then remove them from the environment.
CHURCHERP_BOOTSTRAP_USERNAME=admin
CHURCHERP_BOOTSTRAP_DISPLAY_NAME=Administration
CHURCHERP_BOOTSTRAP_PASSWORD=replace-with-a-strong-temporary-value

# Web Push VAPID identity. Generate one key pair with `pnpm push:generate-vapid`
# and keep the private key exclusively in the server environment.
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.org
WEB_PUSH_VAPID_PUBLIC_KEY=replace-with-generated-public-key
WEB_PUSH_VAPID_PRIVATE_KEY=replace-with-generated-private-key
